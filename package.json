{
  "name": "falsify",
  "version": "0.1.0",
  "description": "A Claude Code plugin that takes a ticket to a pull request and refuses to skip the proof at any step.",
  "private": true,
  "license": "MIT",
  "author": "Maksym Lyskov",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxymlyskov/falsify"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint:commits": "node scripts/check-commit-msg.mjs --range",
    "lint:skills": "bash scripts/check-skills.sh",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
