#!/usr/bin/env node
'use strict';
// Computed confidence for a run — never typed by the model (ADR-0003).
// Usage: scorecard <run-record.json> [--weights <path>]
// (1) any hard gate failing → score 0, NOT SHIPPABLE — defects do not average.
// (2) score = 100 × Σ(w·t·pass) / Σ(w over rows whose tier ≠ —); tier A (executed this run) = 1.0,
//     B (inherited or proxied) = 0.5; Diagnosis only for bugs; QA = fraction of procedure steps with
//     [A] evidence; Mutation drops to tier B when equivalent marks exceed half the tried mutants.
// (3) the row for the ticket's own dimension at tier B caps the verdict at MEDIUM.
// Prints the `## Confidence` block, `## Cost` when step timings exist, then SCORECARD_RESULT.
// The number measures one construct: how much of the claimed confidence was EXECUTED this run
// (Kaner & Bond, METRICS 2004). It does not claim to measure correctness.

const fs = require('node:fs');
const path = require('node:path');
const { emit, usage, parseArgs } = require('../lib/result');

const NAME = 'SCORECARD';
const { positional, flags } = parseArgs(process.argv.slice(2));
if (!positional[0]) usage(NAME, 'usage: scorecard <run-record.json> [--weights <path>]');
let record; let W;
try { record = JSON.parse(fs.readFileSync(positional[0], 'utf8')); } catch (e) { emit(NAME, { ok: false, pass: null, code: 'BAD_RECORD', message: String(e.message) }); }
try { W = JSON.parse(fs.readFileSync(flags.weights || path.join(__dirname, 'scorecard.weights.json'), 'utf8')); } catch (e) { emit(NAME, { ok: false, pass: null, code: 'BAD_WEIGHTS', message: String(e.message) }); }

const gates = record.gates || {};
const g = (k) => gates[k] || null;
const res = (k) => (g(k) && g(k).result) || null;
const isBug = record.kind === 'bug';
const round1 = (x) => Math.round(x * 10) / 10;
const fmtMs = (ms) => { const s = Math.max(0, Math.round(ms / 1000)); return `${Math.floor(s / 60)}m${String(s % 60).padStart(2, '0')}s`; };

// ---- (1) hard gates -----------------------------------------------------------------------------
const hardFailed = [];
for (const k of W.hard) {
  const e = g(k);
  if (k === 'QA') { if (!e || (e.blocking || 0) > 0) hardFailed.push({ gate: k, why: !e ? 'not recorded' : `${e.blocking} blocking finding(s)` }); continue; }
  if (!e) { if (k !== 'G0' && k !== 'G1') hardFailed.push({ gate: k, why: 'not recorded' }); continue; }
  if (e.tier === '—' && e.reason) continue;
  const r = e.result;
  if (r == null) { if (!(e.tier === 'B' && e.reason)) hardFailed.push({ gate: k, why: 'no result and no proxy reason' }); continue; }
  if (r.ok === false) { hardFailed.push({ gate: k, why: r.code || 'ok:false' }); continue; }
  if (r.pass === false) { hardFailed.push({ gate: k, why: r.code || 'pass:false' }); continue; }
  if (r.pass === null && (k === 'G3' || k === 'TAMPER')) hardFailed.push({ gate: k, why: `${r.code || 'pass:null'} — could not measure a hard gate` });
}

// ---- (2) rows -----------------------------------------------------------------------------------
const rows = [];
const push = (name, o) => rows.push({ name, weight: W.weights[name], ...o });
function fromGate(name, key, textFn) {
  const e = g(key);
  if (!e) return push(name, { tier: 'A', value: 0, text: 'not recorded — unmeasured rows earn nothing' });
  const r = e.result;
  if (e.tier === '—') return push(name, { tier: '—', value: 0, text: `n/a — ${e.reason || 'inapplicable'}` });
  if (r && r.pass === null) return push(name, { tier: '—', value: 0, text: `n/a — ${r.code || 'could not measure'}${e.reason ? ` (${e.reason})` : ''}` });
  if (!r) return push(name, { tier: e.tier || 'B', value: 1, text: e.reason || 'proxy' });
  return push(name, { tier: e.tier || 'A', value: r.pass === true ? 1 : 0, text: textFn(r, e) });
}

if (isBug) {
  const p = record.probe; const v = record.verdict || 'no verdict';
  if (g('Diagnosis')) fromGate('Diagnosis', 'Diagnosis', (r) => r.text || v);
  else push('Diagnosis', { tier: p ? 'A' : 'B', value: v === 'CONFIRMED-BUG' ? 1 : 0, text: p ? `${v} — probe ${path.basename(p.spec || '')} "${p.it || ''}" expected ${p.expected} got ${p.actual}` : `${v} — no probe (asserted)` });
}
fromGate('Behaviors', 'G3', (r) => `${r.behaviors ?? r.passing ?? '?'} RED→GREEN${r.failing ? ` · ${r.failing} failing` : ''}`);
fromGate('Regression', 'G4', (r, e) => `${r.specs === 'ALL' ? 'whole suite' : `select-specs: ${Array.isArray(r.specs) ? r.specs.length : r.specs ?? '?'} specs`}, ${r.passing ?? '?'} passing, ${r.failing ?? 0} failing${e.round ? ` (round ${e.round})` : ''}`);
fromGate('FanOut', 'G2', (r) => {
  const names = [...(r.missed || []).map((m) => `${path.basename(m.file)}, conf ${m.conf}`), ...(r.static || []).map((s) => path.basename(s.file))];
  const n = names.length + (r.dismissed || []).length;
  return `${n} flagged${names.length ? ` (${names.join('; ')})` : ''}${(r.dismissed || []).length ? ` — ${r.dismissed.length} dismissed with reasons` : ''}${n && !names.length ? ' — edited' : ''}`;
});
fromGate('Complexity', 'G5', (r) => (r.worst ? `worst ${r.worst.fn} cyclomatic ${r.worst.cyclomatic} / ${r.thresholds.cyclomatic} · cognitive ${r.worst.cognitive} / ${r.thresholds.cognitive}` : `${r.checked} fns checked, ${(r.over || []).length} over, ${(r.preexisting || []).length} preexisting`));
fromGate('Mutation', 'G6', (r) => `killed ${r.killed} of ${r.tried} tried (candidates ${r.candidates}) · survivors ${(r.survivors || []).length} · equivalent ${(r.equivalent || []).length}${r.inconclusive ? ` · inconclusive ${r.inconclusive}` : ''}${r.timeouts ? ` · timeouts ${r.timeouts}` : ''}`);
{ const m = rows.find((x) => x.name === 'Mutation'); const r = res('G6'); if (m && r && r.tried && (r.equivalent || []).length > r.tried / 2) { m.tier = 'B'; m.text += ' — equivalent > tried/2, tier B'; } }
fromGate('RealWorld', 'G7', (r) => r.text || r.summary || (r.screenshot ? `screenshot ${r.screenshot}` : 'proven'));
fromGate('Cleanliness', 'G8', (r) => `${r.fixes ?? 0} fixes${r.findings ? ` · ${r.findings} report-only findings` : ''}`);
{
  const q = g('QA');
  if (!q) push('QA', { tier: 'A', value: 0, text: 'not recorded' });
  else {
    const steps = q.steps || 0; const frac = steps ? (q.stepsA || 0) / steps : 0;
    push('QA', { tier: 'A', value: (q.blocking || 0) > 0 ? 0 : frac, text: `${q.stepsA || 0}/${steps} procedure steps [A] · ${q.edge || 0} edge cases · ${q.house || 0} house checks (${q.fired || 0} fired) · blocking ${q.blocking || 0}` });
  }
}

const applicable = rows.filter((r) => r.tier !== '—');
const denom = applicable.reduce((n, r) => n + r.weight, 0);
const numer = applicable.reduce((n, r) => n + r.weight * (W.tier[r.tier] ?? 0) * r.value, 0);
const score = hardFailed.length ? 0 : denom ? round1((100 * numer) / denom) : 0;
let verdict = hardFailed.length ? 'NOT SHIPPABLE' : score >= W.verdict.HIGH ? 'HIGH' : score >= W.verdict.MEDIUM ? 'MEDIUM' : 'LOW';

// ---- (3) override -------------------------------------------------------------------------------
let capped = null;
if (!hardFailed.length && record.ticketDimension) {
  const want = String(record.ticketDimension).toLowerCase().replace(/[^a-z]/g, '');
  const dim = rows.find((r) => r.name.toLowerCase() === want);
  if (dim && dim.tier === 'B' && verdict === 'HIGH') { verdict = 'MEDIUM'; capped = `${dim.name} is the ticket's dimension and rests on tier B`; }
}

// ---- print --------------------------------------------------------------------------------------
const label = { Diagnosis: 'Diagnosis', Behaviors: 'Behaviors', Regression: 'Regression', FanOut: 'Fan-out', Complexity: 'Complexity', Mutation: 'Mutation', RealWorld: 'Real-world', Cleanliness: 'Cleanliness', QA: 'QA' };
console.log('## Confidence');
for (const name of Object.keys(label)) {
  const r = rows.find((x) => x.name === name);
  if (r) console.log(`${`${label[name].padEnd(13)} ${r.text}`.padEnd(92)} [${r.tier}]`);
}
const g0 = res('G0'); const tp = res('TAMPER'); const ty = res('G1');
const bits = [];
if (g0) bits.push(`${g0.total ?? g0.loc} LOC${g0.warn ? ` (${g0.warn})` : ''}${g0.allowed ? ` — split allowed: ${g0.allowed}` : ''}`);
if (tp) bits.push(tp.pass ? `Tamper clean${(tp.accepted || []).length ? ` (${tp.accepted.length} accepted)` : ''}` : `Tamper ${(tp.findings || []).length} finding(s)`);
if (ty) bits.push(ty.pass === null ? `Types n/a — ${ty.code}` : `Types base ${ty.baseCount} → branch ${ty.branchCount}${g('G1').round ? ` (round ${g('G1').round})` : ''}`);
if (record.degraded && record.degraded.length) bits.push(`budget degraded: ${record.degraded.join(', ')}`);
if (bits.length) console.log(`Size          ${bits.join(' · ')}`);
const wall = record.started ? new Date(record.ended || Date.now()) - new Date(record.started) : 0;
console.log(`Score ${score} / 100 · Verdict ${verdict}${capped ? ` (capped: ${capped})` : ''}${hardFailed.length ? ` — hard gate(s) failed: ${hardFailed.map((h) => `${h.gate} (${h.why})`).join(', ')}` : ''} · rounds ${record.rounds ?? 0} · wall ${fmtMs(wall)} · weights: ${W.provenance}`);

const stepNames = { 1: 'Intake', 2: 'Investigate', 3: 'Probe', 4: 'Grill', 5: 'Design gate', 6: 'Build', 7: 'Battery', 8: 'QA', 9: 'Score', 10: 'Commit/PR', 11: 'Handoff' };
const cost = Object.entries(record.steps || {}).filter(([, s]) => s && s.started).map(([k, s]) => ({ step: k, name: stepNames[k] || k, ms: (s.ended ? new Date(s.ended) : new Date()) - new Date(s.started) }));
if (cost.length) {
  console.log('\n## Cost');
  console.log(`rounds ${record.rounds ?? 0} · wall ${fmtMs(wall)}${record.budgetMin ? ` · budget ${record.budgetMin}m` : ''}${record.degraded && record.degraded.length ? ` · degraded: ${record.degraded.join(', ')}` : ''}`);
  for (const c of cost) console.log(`${String(c.step).padStart(2)} ${c.name.padEnd(12)} ${fmtMs(c.ms)}`);
}

emit(NAME, { pass: verdict === 'HIGH' || verdict === 'MEDIUM', score, verdict, hardFailed: hardFailed.map((h) => h.gate), capped, rows: Object.fromEntries(rows.map((r) => [r.name, { tier: r.tier, value: r.value, weight: r.weight }])), denominator: denom, cost });
